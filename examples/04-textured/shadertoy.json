{
  "name": "textured",
  "description": "Channel inputs: a real file (portable), builtins that mirror stock shadertoy.com textures, and a local-only debug aid.",
  "defaults": {
    "width": 640,
    "height": 360,
    "fps": 60
  },
  "image": {
    "channels": {
      "0": {
        "type": "texture",
        "source": "textures/pattern.png",
        "filter": "linear",
        "wrap": "repeat",
        "vflip": true
      },
      "1": {
        "type": "builtin",
        "source": "rgba-noise-medium",
        "filter": "linear",
        "wrap": "repeat"
      },
      "2": {
        "type": "builtin",
        "source": "bayer",
        "filter": "nearest",
        "wrap": "repeat"
      },
      "3": {
        "type": "builtin",
        "source": "uv",
        "filter": "linear",
        "wrap": "clamp"
      }
    }
  }
}
