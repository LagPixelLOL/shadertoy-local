{
  "name": "cumulus",
  "description": "An isolated fair-weather cumulus with soft volumetric scattering and wind-torn margins. Full-resolution raymarch in Buffer A, rotation-reprojected temporal resolve in Buffer B. Drag the mouse to steer the sun (x azimuth, y elevation); press S to toggle moonlight.",
  "defaults": {
    "width": 640,
    "height": 360,
    "fps": 60
  },
  "buffer_a": {
    "channels": {
      "0": {
        "type": "builtin",
        "source": "rgba-noise-medium",
        "filter": "linear",
        "wrap": "repeat"
      },
      "1": {
        "type": "keyboard"
      }
    }
  },
  "buffer_b": {
    "channels": {
      "0": {
        "type": "buffer",
        "source": "buffer_a",
        "filter": "nearest",
        "wrap": "clamp"
      },
      "1": {
        "type": "buffer",
        "source": "buffer_b",
        "filter": "linear",
        "wrap": "clamp"
      },
      "2": {
        "type": "keyboard"
      }
    }
  },
  "image": {
    "channels": {
      "0": {
        "type": "buffer",
        "source": "buffer_b",
        "filter": "linear",
        "wrap": "clamp"
      },
      "1": {
        "type": "keyboard"
      }
    }
  }
}
